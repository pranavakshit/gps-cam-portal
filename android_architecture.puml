@startuml
skinparam componentStyle uml2

package "Android App (in.pranavakshit.gps)" {
  
  package "UI Layer (Activities/Fragments)" {
    component "Camera Interface" as CameraUI
    component "LGD Location Picker" as LocationPicker
    component "Dashboard & Sync Manager" as DashboardUI
  }
  
  package "Business Logic" {
    component "Location Service\n(Fused Location Provider)" as LocationService
    component "Sync Worker\n(Background Tasks)" as SyncWorker
    component "Auth Manager\n(JWT Handling)" as AuthManager
  }
  
  package "Data Layer" {
    component "Retrofit API Client\n(Network layer)" as ApiClient
    database "SQLite Database\n(Room Persistence)" as SQLite {
      [Photos Table (Offline Cache)]
      [LGD Hierarchy (State/District/Village)]
    }
  }
}

CameraUI --> LocationService : Request GPS Coords
LocationPicker --> SQLite : Read LGD Data
CameraUI --> SQLite : Save Photo & Coords Locally
DashboardUI --> AuthManager : Manage Session
DashboardUI --> SyncWorker : Trigger Sync
SyncWorker --> SQLite : Read Unsynced Photos
SyncWorker --> ApiClient : Push Data via HTTP
ApiClient --> AuthManager : Attach JWT Token

@enduml
