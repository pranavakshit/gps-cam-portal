@startuml
skinparam componentStyle uml2

package "Web Portal (Vite/React SPA)" {
  
  package "Components Layer" {
    component "Dashboard" as Dashboard
    component "Photo Gallery" as Gallery
    component "Location Manager" as LocationManager
    component "Users Manager" as UsersManager
    component "Login & 2FA Interface" as LoginUI
  }
  
  package "Context & State Management" {
    component "AuthContext" as AuthContext
    component "Role-Based UI Guards" as UI_Guards
  }
  
  package "API & Routing" {
    component "React Router" as Router
    component "Axios HTTP Client\n(JWT Interceptor)" as Axios
  }
}

actor "Portal User\n(Admin/User/Visitor)" as User

User --> Router : Navigates
Router --> LoginUI : Unauthenticated
Router --> Dashboard : Authenticated
Dashboard --> UI_Guards : Check Role
UI_Guards --> UsersManager : Admin Only
UI_Guards --> LocationManager : Admin Only
UI_Guards --> Gallery : All Roles

LoginUI --> AuthContext : Set JWT Token
AuthContext --> Axios : Inject Token in Header
UsersManager --> Axios : HTTP Requests
LocationManager --> Axios : HTTP Requests
Gallery --> Axios : HTTP Requests

Axios --> [External Backend API] : Network Call

@enduml
